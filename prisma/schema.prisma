datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum BusinessRole {
  BUSINESS_OWNER
  BILLING_STAFF
  ACCOUNTANT
  INVENTORY_MANAGER
  OWNER
  MANAGER
  OPERATOR
  VIEWER
}

enum AccessScopeType {
  ALL
  SELECTED
}

enum AccountantInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SubscriptionPlan {
  FREE_TRIAL
  STARTER
  GROWTH_PRO
  ENTERPRISE
  FREE_KHATA
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum GstType {
  CGST_SGST
  IGST
  EXEMPT
}

enum WhatsAppConfigStatus {
  NOT_CONFIGURED
  CONNECTED
  ERROR
}

enum WhatsAppMessageType {
  INVOICE_SHARE
  PAYMENT_RECEIPT
  ACCOUNT_STATEMENT
  PAYMENT_REMINDER
}

enum WhatsAppMessageStatus {
  QUEUED
  SUBMITTED
  DELIVERED
  READ
  FAILED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  phone        String?
  passwordHash String
  googleId     String?      @unique
  avatarUrl    String?
  platformRole PlatformRole @default(USER)
  isDemo       Boolean      @default(false)
  isSuspended  Boolean      @default(false)
  suspendedReason String?
  preferredLanguage String   @default("en")
  upiId             String?
  upiQrImageUrl     String?
  upiBeneficiaryName String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships                  BusinessMembership[]
  sessions                     Session[]
  khataContacts                KhataContact[]
  khataTransactions            KhataTransaction[]
  khataRepayments              KhataRepayment[]
  householdMemberships         HouseholdMember[]
  createdHouseholdTransactions HouseholdTransaction[]
  sentHouseholdInvitations     HouseholdInvitation[]
  accountantAccesses           AccountantBusinessAccess[] @relation("AccountantUser")
  grantedAccountantAccesses    AccountantBusinessAccess[] @relation("AccountantGrantedBy")
  sentAccountantInvitations    AccountantInvitation[]     @relation("AccountantInvitedBy")
  acceptedAccountantInvites    AccountantInvitation[]     @relation("AccountantAcceptedBy")
  requestedApprovals           ApprovalRequest[]          @relation("ApprovalRequestedBy")
  decidedApprovals             ApprovalRequest[]          @relation("ApprovalDecidedBy")
  auditEvents                  AuditEvent[]
  khBookmarks                  KhBookmark[]

  @@index([email])
  @@index([googleId])
  @@index([platformRole])
  @@index([preferredLanguage])
}

model Business {
  id                 String             @id @default(cuid())
  name               String
  legalName          String?
  tradeType          String?
  gstin              String?
  city               String?
  state              String?
  phone              String?
  email              String?
  currency           String             @default("INR")
  address            String?
  pincode            String?
  bankName           String?
  bankAccountNumber  String?
  bankIfsc           String?
  bankUpiId          String?
  upiQrImageUrl      String?
  upiBeneficiaryName String?
  invoiceTerms       String?
  invoiceLanguage    String?            @default("en")
  allowNegativeStock Boolean            @default(false)
  isDemo             Boolean            @default(false)
  logoUrl            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  memberships        BusinessMembership[]
  subscriptions      Subscription[]
  sessions           Session[]
  customers          Customer[]
  invoices           Invoice[]
  payments           Payment[]
  invoiceSequence    InvoiceSequence?
  products           Product[]
  stockMovements     StockMovement[]
  suppliers          Supplier[]
  purchases          Purchase[]
  supplierPayments   SupplierPayment[]
  purchaseSequence   PurchaseSequence?
  whatsAppConfig     WhatsAppConfig?
  whatsAppLogs       WhatsAppMessageLog[]
  expenses           Expense[]
  khataContacts      KhataContact[]
  khataTransactions  KhataTransaction[]
  khataRepayments    KhataRepayment[]
  subscriptionPayments SubscriptionPayment[]
  creditDebitNotes      CreditDebitNote[]
  gstr2bImports         Gstr2bImport[]
  quotations            Quotation[]
  quotationSequence     QuotationSequence?
  branches              Branch[]
  financialYears        FinancialYear[]
  roles                 Role[]
  accountantInvitations AccountantInvitation[]
  accountantAccesses    AccountantBusinessAccess[]
  approvalRequests      ApprovalRequest[]
  auditEvents           AuditEvent[]
  featureFlags          FeatureFlag[]
  accountingGroups      AccountingGroup[]
  ledgers               Ledger[]
  vouchers              Voucher[]
  ledgerBalances        LedgerBalance[]

  @@index([name])
}

model BusinessMembership {
  id              String       @id @default(cuid())
  userId          String
  businessId      String
  role            BusinessRole @default(BUSINESS_OWNER)
  branchIds       String[]     @default([])
  financialYears  String[]     @default([])
  permissions     String[]     @default([])
  isActive        Boolean      @default(true)
  invitedByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@index([isActive])
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String
  plan               SubscriptionPlan   @default(FREE_TRIAL)
  status             SubscriptionStatus @default(TRIALING)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  trialDaysRemaining Int                @default(14)
  monthlyPrice       Float              @default(0)
  maxMonthlyInvoices Int                @default(500)
  maxCounters        Int                @default(1)
  maxBranches        Int                @default(1)
  maxStaffSeats      Int                @default(3)
  whatsAppQuota      Int                @default(100)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionPayments SubscriptionPayment[]

  @@index([businessId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  businessId   String?
  branchId     String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  branch       Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([sessionToken])
  @@index([userId])
  @@index([businessId])
  @@index([branchId])
}

// ============================================================
// PHASE 1: MULTI-BRANCH, FINANCIAL YEARS, RBAC, ACCOUNTANT & AUDIT
// ============================================================

model Branch {
  id         String    @id @default(cuid())
  businessId String
  name       String
  code       String
  gstin      String?
  state      String?
  city       String?
  address    String?
  isDefault  Boolean   @default(false)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions   Session[]
  vouchers   Voucher[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
}

model FinancialYear {
  id          String    @id @default(cuid())
  businessId  String
  code        String
  label       String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean   @default(true)
  isClosed    Boolean   @default(false)
  lockedUntil DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
}

model Role {
  id              String           @id @default(cuid())
  businessId      String?
  key             String
  name            String
  description     String?
  isSystem        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]

  @@unique([businessId, key])
  @@index([key])
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  module          String
  description     String?
  createdAt       DateTime         @default(now())

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  allowed      Boolean    @default(true)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AccountantInvitation {
  id                  String                     @id @default(cuid())
  businessId          String
  invitedEmail        String
  invitedName         String?
  invitedByUserId     String
  tokenHash           String                     @unique
  branchScope         AccessScopeType            @default(ALL)
  branchIds           String[]                   @default([])
  fyScope             AccessScopeType            @default(ALL)
  financialYears      String[]                   @default([])
  permissions         String[]                   @default([])
  canApproveSensitive Boolean                    @default(false)
  canFileGst          Boolean                    @default(false)
  status              AccountantInvitationStatus @default(PENDING)
  acceptedByUserId    String?
  acceptedAt          DateTime?
  revokedAt           DateTime?
  expiresAt           DateTime
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  business            Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy           User                       @relation("AccountantInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy          User?                      @relation("AccountantAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([invitedEmail, status])
  @@index([tokenHash])
}

model AccountantBusinessAccess {
  id                  String          @id @default(cuid())
  userId              String
  businessId          String
  grantedByUserId     String
  branchScope         AccessScopeType @default(ALL)
  branchIds           String[]        @default([])
  fyScope             AccessScopeType @default(ALL)
  financialYears      String[]        @default([])
  permissions         String[]        @default([])
  canApproveSensitive Boolean         @default(false)
  canFileGst          Boolean         @default(false)
  isActive            Boolean         @default(true)
  revokedAt           DateTime?
  revokedReason       String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation("AccountantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy           User            @relation("AccountantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Cascade)
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId, isActive])
  @@index([businessId, isActive])
}

model ApprovalRequest {
  id                String         @id @default(cuid())
  businessId        String
  requestedByUserId String
  decidedByUserId   String?
  requestType       String
  entityType        String
  entityId          String?
  title             String
  summary           String?
  payload           Json?
  status            ApprovalStatus @default(PENDING)
  decisionNotes     String?
  decidedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedBy       User           @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  decidedBy         User?          @relation("ApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, status])
  @@index([requestedByUserId])
}

model AuditEvent {
  id            String    @id @default(cuid())
  businessId    String
  actorUserId   String
  actorEmail    String?
  actorName     String?
  actorRole     String?
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  reason        String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor         User      @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, entityType, entityId])
  @@index([actorUserId])
}

model FeatureFlag {
  id         String    @id @default(cuid())
  businessId String?
  key        String
  enabled    Boolean   @default(false)
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, key])
  @@index([key])
}

model Customer {
  id              String       @id @default(cuid())
  businessId      String
  name            String
  mobile          String
  email           String?
  billingAddress  String?
  shippingAddress String?
  gstin           String?
  openingBalance  Float        @default(0)
  notes           String?
  optedOutWhatsApp Boolean     @default(false)
  lastReminderSentAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  payments        Payment[]
  whatsAppLogs    WhatsAppMessageLog[]
  creditDebitNotes CreditDebitNote[]
  quotations      Quotation[]

  @@index([businessId])
  @@index([name])
  @@index([mobile])
}

model InvoiceSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  prefix        String   @default("INV")
  fiscalYear    String
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                 String        @id @default(cuid())
  businessId         String
  customerId         String
  invoiceNumber      String
  invoiceDate        DateTime      @default(now())
  dueDate            DateTime
  status             InvoiceStatus @default(UNPAID)

  // GST & Tax Configuration
  gstType            GstType       @default(CGST_SGST)
  isTaxInclusive     Boolean       @default(false)
  isGstInvoice       Boolean       @default(true)

  // Financial figures (calculated strictly server-side with decimal safety)
  subtotal           Float         @default(0)
  discountTotal      Float         @default(0)
  taxTotal           Float         @default(0)
  cgstTotal          Float         @default(0)
  sgstTotal          Float         @default(0)
  igstTotal          Float         @default(0)
  rounding           Float         @default(0)
  total              Float         @default(0)
  paidAmount         Float         @default(0)
  balanceDue         Float         @default(0)

  // Historical snapshot for audit integrity (preserves profile changes)
  customerName       String
  customerMobile     String
  customerGstin      String?
  customerBillingAddress String?
  businessName       String
  businessGstin      String?
  businessAddress    String?
  businessLogoUrl    String?

  notes              String?
  termsAndConditions String?

  // Cancellation & Void Audit Trail
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items              InvoiceItem[]
  payments           Payment[]
  whatsAppLogs       WhatsAppMessageLog[]
  creditDebitNotes   CreditDebitNote[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceDate])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  productId      String?
  hsnCode        String?
  description    String
  quantity       Float
  unit           String   @default("Pcs")
  rate           Float
  discount       Float    @default(0)
  discountType   String   @default("AMOUNT")
  taxRate        Float    @default(0)
  taxAmount      Float    @default(0)
  cgstRate       Float    @default(0)
  cgstAmount     Float    @default(0)
  sgstRate       Float    @default(0)
  sgstAmount     Float    @default(0)
  igstRate       Float    @default(0)
  igstAmount     Float    @default(0)
  lineTotal      Float

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(cuid())
  businessId      String
  invoiceId       String
  customerId      String
  amount          Float
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod @default(CASH)
  referenceNumber String?
  notes           String?
  idempotencyKey  String?       @unique
  createdAt       DateTime      @default(now())

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentDate])
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_RECEIVED
  SALE_DEDUCTION
  SALE_RETURN
  PURCHASE_RETURN
  MANUAL_ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model Product {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  sku            String
  barcode        String?
  category       String          @default("General")
  unit           String          @default("Pcs")
  purchasePrice  Float           @default(0)
  sellingPrice   Float           @default(0)
  taxRate        Float           @default(0)
  hsnCode        String?
  currentStock   Float           @default(0)
  openingStock   Float           @default(0)
  lowStockAlert  Float           @default(10)
  description    String?
  imageUrl       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseItem[]
  quotationItems QuotationItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([name])
  @@index([category])
  @@index([barcode])
  @@index([isActive])
}

model StockMovement {
  id                 String            @id @default(cuid())
  businessId         String
  productId          String
  type               StockMovementType
  quantity           Float
  previousStock      Float
  newStock           Float
  sourceDocumentType String?           // 'INVOICE', 'PURCHASE', 'MANUAL_ADJUSTMENT', 'RETURN'
  sourceDocumentId   String?
  reason             String?
  actorName          String?
  createdAt          DateTime          @default(now())

  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@index([type])
  @@index([sourceDocumentType, sourceDocumentId])
  @@index([createdAt])
}

model Supplier {
  id              String            @id @default(cuid())
  businessId      String
  name            String
  phone           String
  email           String?
  address         String?
  gstin           String?
  openingBalance  Float             @default(0)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases       Purchase[]
  payments        SupplierPayment[]
  creditDebitNotes CreditDebitNote[]

  @@index([businessId])
  @@index([name])
  @@index([phone])
}

model PurchaseSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  prefix        String   @default("PUR")
  fiscalYear    String
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Purchase {
  id                     String            @id @default(cuid())
  businessId             String
  supplierId             String
  purchaseNumber         String
  supplierInvoiceNumber  String?
  purchaseDate           DateTime          @default(now())
  dueDate                DateTime?
  status                 PurchaseStatus    @default(DRAFT)

  subtotal               Float             @default(0)
  discountTotal          Float             @default(0)
  taxTotal               Float             @default(0)
  cgstTotal              Float             @default(0)
  sgstTotal              Float             @default(0)
  igstTotal              Float             @default(0)
  total                  Float             @default(0)
  paidAmount             Float             @default(0)
  balanceDue             Float             @default(0)

  // GST & ITC Classification
  itcEligibility         String            @default("ELIGIBLE") // ELIGIBLE, INELIGIBLE, BLOCKED_SEC_17_5, CAPITAL_GOODS, PENDING_VERIFICATION, RECONCILED
  placeOfSupply          String?
  documentUrl            String?
  scannedBillUrl         String?
  ocrData                Json?

  notes                  String?
  receivedAt             DateTime?
  receivedBy             String?
  cancelledAt            DateTime?
  cancelledBy            String?
  cancellationReason     String?

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  business               Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier               Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items                  PurchaseItem[]
  payments               SupplierPayment[]

  @@unique([businessId, purchaseNumber])
  @@index([businessId])
  @@index([supplierId])
  @@index([status])
  @@index([purchaseDate])
}

model PurchaseItem {
  id           String    @id @default(cuid())
  purchaseId   String
  productId    String?
  hsnCode      String?
  description  String
  quantity     Float
  unit         String    @default("Pcs")
  purchaseRate Float
  discount     Float     @default(0)
  taxRate      Float     @default(0)
  taxAmount    Float     @default(0)
  cgstRate     Float     @default(0)
  cgstAmount   Float     @default(0)
  sgstRate     Float     @default(0)
  sgstAmount   Float     @default(0)
  igstRate     Float     @default(0)
  igstAmount   Float     @default(0)
  lineTotal    Float

  purchase     Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
}

model SupplierPayment {
  id              String        @id @default(cuid())
  businessId      String
  purchaseId      String
  supplierId      String
  amount          Float
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  idempotencyKey  String?       @unique
  recordedBy      String?
  createdAt       DateTime      @default(now())

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([purchaseId])
  @@index([supplierId])
  @@index([paymentDate])
}

model WhatsAppConfig {
  id                    String               @id @default(cuid())
  businessId            String               @unique
  status                WhatsAppConfigStatus @default(NOT_CONFIGURED)
  phoneNumberId         String?
  wabaId                String?
  accessToken           String?
  webhookVerifyToken    String?
  businessDisplayName   String?
  autoRemindersEnabled  Boolean              @default(false)
  reminderDaysBeforeDue Int                  @default(3)
  reminderOnDueDate     Boolean              @default(true)
  reminderDaysAfterDue  Int                  @default(3)
  quietHoursStart       Int                  @default(21) // 9 PM (24h)
  quietHoursEnd         Int                  @default(9)  // 9 AM (24h)
  isPaused              Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model WhatsAppMessageLog {
  id                 String                @id @default(cuid())
  businessId         String
  customerId         String?
  invoiceId          String?
  recipientPhone     String
  recipientName      String?
  messageType        WhatsAppMessageType
  status             WhatsAppMessageStatus @default(SUBMITTED)
  providerMessageId  String?
  contentSummary     String
  idempotencyKey     String?               @unique
  errorMessage       String?
  sentAt             DateTime              @default(now())
  deliveredAt        DateTime?
  readAt             DateTime?
  actor              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice            Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@index([providerMessageId])
  @@index([createdAt])
}

model Expense {
  id              String        @id @default(cuid())
  businessId      String
  category        String
  payee           String
  amount          Float
  paymentMethod   PaymentMethod @default(CASH)
  expenseDate     DateTime      @default(now())
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([category])
  @@index([expenseDate])
}

enum KhataTransactionType {
  GAVE
  RECEIVED
}

enum KhataEntryStatus {
  PENDING
  PARTIAL
  SETTLED
}

model KhataContact {
  id           String             @id @default(cuid())
  businessId   String
  userId       String?
  name         String
  phone        String?
  email        String?
  notes        String?
  lastReminderSentAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions KhataTransaction[]
  repayments   KhataRepayment[]

  @@index([businessId])
  @@index([userId])
  @@index([name])
  @@index([phone])
}

model KhataTransaction {
  id            String               @id @default(cuid())
  businessId    String
  userId        String?
  contactId     String
  type          KhataTransactionType
  amount        Float
  date          DateTime             @default(now())
  dueDate       DateTime?
  description   String?
  paymentMode   PaymentMethod        @default(CASH)
  paymentRef    String?
  paymentDetails String?
  status        KhataEntryStatus     @default(PENDING)
  settledAmount Float                @default(0)
  balanceAmount Float
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact       KhataContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  repayments    KhataRepayment[]

  @@index([businessId])
  @@index([userId])
  @@index([contactId])
  @@index([type])
  @@index([status])
  @@index([date])
  @@index([dueDate])
  @@index([paymentMode])
}

model KhataRepayment {
  id            String           @id @default(cuid())
  businessId    String
  userId        String?
  contactId     String
  transactionId String
  amount        Float
  date          DateTime         @default(now())
  paymentMode   PaymentMethod    @default(CASH)
  paymentRef    String?
  paymentDetails String?
  notes         String?
  createdAt     DateTime         @default(now())

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact       KhataContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  transaction   KhataTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([contactId])
  @@index([transactionId])
  @@index([date])
}

model SubscriptionPayment {
  id               String           @id @default(cuid())
  businessId       String
  subscriptionId   String?
  amount           Float
  currency         String           @default("INR")
  plan             SubscriptionPlan
  status           String           @default("SUCCESS") // "PENDING", "SUCCESS", "FAILED", "CANCELLED", "REFUNDED"
  gateway          String           @default("RAZORPAY") // "RAZORPAY", "CASHFREE", "MANUAL_UPI", "BANK_TRANSFER"
  gatewayPaymentId String?
  gatewayOrderId   String?
  idempotencyKey   String?          @unique
  notes            String?
  billingPeriod    String           @default("MONTHLY") // "MONTHLY", "ANNUAL"
  paidAt           DateTime?
  refundedAt       DateTime?
  refundAmount     Float?           @default(0)
  reconciledBy     String?
  discountCode     String?
  discountAmount   Float?           @default(0)
  originalAmount   Float?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription     Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

model PlatformAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  adminName  String
  action     String   // e.g. "USER_SUSPEND", "USER_REACTIVATE", "TENANT_SUSPEND", "TENANT_REACTIVATE", "PLAN_CORRECTION", "TRIAL_EXTENSION", "PAYMENT_RECONCILE", "SETTINGS_UPDATE"
  targetType String   // e.g. "USER", "BUSINESS", "SUBSCRIPTION", "PAYMENT", "SETTING"
  targetId   String?
  targetName String?
  reason     String?
  outcome    String   @default("SUCCESS") // "SUCCESS" | "FAILED"
  metadata   Json?    // Extra contextual data or diff
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL") // "GENERAL", "BILLING", "SECURITY", "NOTIFICATIONS"
  description String?
  isSecret    Boolean  @default(false)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([category])
}

enum NoteType {
  CREDIT_NOTE
  DEBIT_NOTE
}

model CreditDebitNote {
  id                    String        @id @default(cuid())
  businessId            String
  noteType              NoteType
  noteNumber            String
  noteDate              DateTime      @default(now())
  originalInvoiceId     String?
  originalInvoiceNumber String?
  customerId            String?
  supplierId            String?
  partyName             String
  partyGstin            String?
  reason                String        // "SALES_RETURN", "DEFICIENT_SERVICE", "POST_SALE_DISCOUNT", "PRICE_CORRECTION", "PURCHASE_RETURN"
  
  taxableValue          Float         @default(0)
  taxTotal              Float         @default(0)
  cgstTotal             Float         @default(0)
  sgstTotal             Float         @default(0)
  igstTotal             Float         @default(0)
  total                 Float         @default(0)
  
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  business              Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  originalInvoice       Invoice?      @relation(fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier              Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([businessId, noteNumber])
  @@index([businessId])
  @@index([noteType])
  @@index([noteDate])
}

model Gstr2bImport {
  id                  String        @id @default(cuid())
  businessId          String
  returnPeriod        String        // e.g. "102026" (MMYYYY)
  financialYear       String        // e.g. "2026-2027"
  sourceFileName      String?
  totalInvoices       Int           @default(0)
  totalTaxable        Float         @default(0)
  totalCgst           Float         @default(0)
  totalSgst           Float         @default(0)
  totalIgst           Float         @default(0)
  matchedCount        Int           @default(0)
  mismatchCount       Int           @default(0)
  missingInBooksCount Int           @default(0)
  missingIn2bCount    Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries             Gstr2bEntry[]

  @@index([businessId])
  @@index([returnPeriod])
}

model Gstr2bEntry {
  id                   String        @id @default(cuid())
  importId             String
  supplierGstin        String
  supplierName         String?
  invoiceNumber        String
  invoiceDate          DateTime
  invoiceType          String        @default("R") // "R" (Regular), "C" (Credit Note), "D" (Debit Note)
  placeOfSupply        String?
  taxableValue         Float         @default(0)
  cgstAmount           Float         @default(0)
  sgstAmount           Float         @default(0)
  igstAmount           Float         @default(0)
  totalAmount          Float         @default(0)
  itcAvailability      String        @default("Y") // "Y" (Eligible), "N" (Ineligible)
  reconciliationStatus String        @default("UNRECONCILED") // "MATCHED", "MISMATCH_TAX", "MISSING_IN_PURCHASES", "DUPLICATE"
  matchedPurchaseId    String?
  matchNotes           String?
  createdAt            DateTime      @default(now())

  gstr2bImport         Gstr2bImport  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([supplierGstin])
  @@index([reconciliationStatus])
}

// ============================================================================
// PAKKACHITTHA GHAR KHARCHA — FREE HOUSEHOLD MODE
// ============================================================================

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum HouseholdTransactionType {
  INCOME
  EXPENSE
}

enum HouseholdInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Household {
  id             String                 @id @default(cuid())
  name           String
  currency       String                 @default("INR")
  monthlyBudget  Float?                 @default(0)
  budgetStartDay Int                    @default(1)
  isArchived     Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  members        HouseholdMember[]
  transactions   HouseholdTransaction[]
  categories     HouseholdCategory[]
  invitations    HouseholdInvitation[]
  budgets        HouseholdMonthlyBudget[]
  settlements    HouseholdSettlement[]

  @@index([name])
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String?
  name        String?
  phone       String?
  relationship String?
  isDirectRecord Boolean    @default(false)
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  paidTransactions     HouseholdTransaction[]         @relation("PaidTransactions")
  expenseSplits        HouseholdExpenseSplit[]
  expenseContributions HouseholdExpenseContribution[]
  settlementsPaid      HouseholdSettlement[]          @relation("SettlementsPaid")
  settlementsReceived  HouseholdSettlement[]          @relation("SettlementsReceived")

  @@unique([userId, householdId])
  @@index([householdId])
  @@index([userId])
}

model HouseholdInvitation {
  id           String                @id @default(cuid())
  householdId  String
  inviterId    String
  inviteeEmail String?
  inviteToken  String                @unique
  role         HouseholdRole         @default(MEMBER)
  status       HouseholdInviteStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  household    Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inviter      User                  @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([inviteToken])
  @@index([inviteeEmail])
}

model HouseholdCategory {
  id            String                   @id @default(cuid())
  householdId   String?                  // Nullable for default templates or scoped to household
  name          String
  type          HouseholdTransactionType
  icon          String?
  color         String?
  monthlyBudget Float?
  isDefault     Boolean                  @default(false)
  isArchived    Boolean                  @default(false)
  subcategories String[]                 @default([])
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  household     Household?               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions  HouseholdTransaction[]

  @@unique([householdId, name, type])
  @@index([householdId])
  @@index([type])
  @@index([isArchived])
}

model HouseholdTransaction {
  id              String                   @id @default(cuid())
  householdId     String
  createdById     String
  type            HouseholdTransactionType
  amount          Float
  categoryId      String?
  categoryName    String                   // Denormalized snapshot for audit integrity
  subcategory     String?
  date            DateTime                 @default(now())
  paymentMethod   PaymentMethod            @default(CASH)
  description     String?
  payeeMerchant   String?
  notes           String?

  // Splitting & Payer metadata
  isShared        Boolean                  @default(false)
  splitType       String?                  // 'EQUAL' | 'CUSTOM' | null
  paidByMemberId  String?
  paidByName      String?

  // Bills & Recharge metadata
  billType        String?                  // 'MOBILE_RECHARGE' | 'MOBILE_POSTPAID' | 'ELECTRICITY' | 'WATER' | 'GAS' | 'INTERNET' | 'DTH' | null
  billProvider    String?
  billConsumerId  String?
  billPeriod      String?
  billDueDate     DateTime?
  billReferenceNo String?

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  household       Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  category        HouseholdCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paidByMember    HouseholdMember?         @relation("PaidTransactions", fields: [paidByMemberId], references: [id], onDelete: SetNull)

  splits          HouseholdExpenseSplit[]
  contributions   HouseholdExpenseContribution[]

  @@index([householdId])
  @@index([householdId, date])
  @@index([householdId, type])
  @@index([createdById])
  @@index([categoryId])
  @@index([isShared])
  @@index([billType])
  @@index([paidByMemberId])
}

model HouseholdExpenseSplit {
  id              String               @id @default(cuid())
  transactionId   String
  memberId        String
  allocatedAmount Float
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  transaction     HouseholdTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  member          HouseholdMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([transactionId, memberId])
  @@index([transactionId])
  @@index([memberId])
}

model HouseholdExpenseContribution {
  id            String               @id @default(cuid())
  transactionId String
  memberId      String
  amount        Float
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  transaction   HouseholdTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  member        HouseholdMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([transactionId, memberId])
  @@index([transactionId])
  @@index([memberId])
}

model HouseholdSettlement {
  id               String          @id @default(cuid())
  householdId      String
  payerMemberId    String
  receiverMemberId String
  amount           Float
  date             DateTime        @default(now())
  paymentMethod    PaymentMethod   @default(UPI)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payerMember      HouseholdMember @relation("SettlementsPaid", fields: [payerMemberId], references: [id], onDelete: Cascade)
  receiverMember   HouseholdMember @relation("SettlementsReceived", fields: [receiverMemberId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([payerMemberId])
  @@index([receiverMemberId])
  @@index([date])
}

model HouseholdMonthlyBudget {
  id          String    @id @default(cuid())
  householdId String
  monthYear   String    // e.g. "2026-10"
  amount      Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, monthYear])
  @@index([householdId])
}

// ============================================================================
// QUOTATIONS (ALL SUBSCRIPTION PLANS)
// ============================================================================

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
  EXPIRED
}

model QuotationSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  prefix        String   @default("QTN")
  fiscalYear    String
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Quotation {
  id                     String          @id @default(cuid())
  businessId             String
  customerId             String
  quotationNumber        String
  quotationDate          DateTime        @default(now())
  validUntil             DateTime
  status                 QuotationStatus @default(DRAFT)

  // GST & Tax Configuration
  gstType                GstType         @default(CGST_SGST)
  isTaxInclusive         Boolean         @default(false)
  isGstInvoice           Boolean         @default(true)

  // Financial figures
  subtotal               Float           @default(0)
  discountTotal          Float           @default(0)
  taxTotal               Float           @default(0)
  cgstTotal              Float           @default(0)
  sgstTotal              Float           @default(0)
  igstTotal              Float           @default(0)
  rounding               Float           @default(0)
  total                  Float           @default(0)

  // Historical snapshot
  customerName           String
  customerMobile         String
  customerGstin          String?
  customerBillingAddress String?
  businessName           String
  businessGstin          String?
  businessAddress        String?
  businessLogoUrl        String?

  notes                  String?
  termsAndConditions     String?
  convertedInvoiceId     String?

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  business               Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer               Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items                  QuotationItem[]

  @@unique([businessId, quotationNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([quotationDate])
}

model QuotationItem {
  id             String    @id @default(cuid())
  quotationId    String
  productId      String?
  hsnCode        String?
  description    String
  quantity       Float
  unit           String    @default("Pcs")
  rate           Float
  discount       Float     @default(0)
  discountType   String    @default("AMOUNT")
  taxRate        Float     @default(0)
  taxAmount      Float     @default(0)
  cgstRate       Float     @default(0)
  cgstAmount     Float     @default(0)
  sgstRate       Float     @default(0)
  sgstAmount     Float     @default(0)
  igstRate       Float     @default(0)
  igstAmount     Float     @default(0)
  lineTotal      Float

  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product        Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([productId])
}

model SubscriptionPlanPricing {
  id             String   @id @default(cuid())
  planKey        String   // "STARTER", "GROWTH", "SCALE"
  interval       String   // "MONTHLY", "THREE_MONTHS", "SIX_MONTHS", "YEARLY"
  durationMonths Int      // 1, 3, 6, 12
  price          Float    // Price in INR
  isActive       Boolean  @default(true)
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([planKey, interval])
  @@index([planKey])
}

model DiscountCode {
  id                  String          @id @default(cuid())
  code                String          @unique
  description         String?
  type                String          @default("PERCENTAGE") // "PERCENTAGE", "FIXED"
  value               Float           // e.g. 20 for 20% or 100 for Rs.100
  applicablePlans     String          @default("ALL") // "ALL" or "STARTER,GROWTH,SCALE"
  applicableDurations String          @default("ALL") // "ALL" or "MONTHLY,THREE_MONTHS,SIX_MONTHS,YEARLY"
  maxDiscountAmount   Float?          // Maximum cap for percentage discounts
  minPurchaseAmount   Float?          @default(0)
  totalUsageLimit     Int?            // Total times code can be redeemed across all users
  usedCount           Int             @default(0)
  perCustomerLimit    Int?            @default(1)
  startDate           DateTime?
  expiryDate          DateTime?
  newCustomersOnly    Boolean         @default(false)
  isActive            Boolean         @default(true)
  createdBy           String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  usages              DiscountUsage[]
  @@index([code])
  @@index([isActive])
}

model DiscountUsage {
  id             String       @id @default(cuid())
  discountCodeId String
  userId         String
  businessId     String?
  orderId        String?
  paymentId      String?
  originalAmount Float
  discountAmount Float
  finalAmount    Float
  usedAt         DateTime     @default(now())

  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)

  @@index([discountCodeId])
  @@index([userId])
  @@index([businessId])
}

// ============================================================================
// ERP PHASE 2 — DOUBLE-ENTRY ACCOUNTING ENGINE (SCALE PLAN ONLY)
// ============================================================================

enum AccountingGroupType {
  ASSETS
  LIABILITIES
  INCOME
  EXPENSES
  CAPITAL
}

enum VoucherType {
  SALES
  PURCHASE
  PAYMENT
  RECEIPT
  CONTRA
  JOURNAL
  DEBIT_NOTE
  CREDIT_NOTE
  OPENING_BALANCE
  CLOSING_ENTRY
}

enum VoucherStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum LedgerNature {
  DEBIT_NORMAL
  CREDIT_NORMAL
}

model AccountingGroup {
  id            String              @id @default(cuid())
  businessId    String
  name          String
  description   String?
  type          AccountingGroupType
  parentGroupId String?
  sortOrder     Int                 @default(0)
  isSystem      Boolean             @default(false)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  parentGroup   AccountingGroup?    @relation("GroupHierarchy", fields: [parentGroupId], references: [id], onDelete: SetNull)
  childGroups   AccountingGroup[]   @relation("GroupHierarchy")
  ledgers       Ledger[]

  @@index([businessId])
  @@index([type])
  @@index([parentGroupId])
}

model Ledger {
  id                   String              @id @default(cuid())
  businessId           String
  name                 String
  code                 String?
  groupId              String
  nature               LedgerNature
  openingBalance       Decimal             @default(0) @db.Decimal(15, 2)
  openingBalanceType   String              @default("DR")
  fyCode               String              @default("ALL")
  isSystem             Boolean             @default(false)
  isActive             Boolean             @default(true)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  business             Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  group                AccountingGroup     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  voucherEntries       VoucherEntry[]
  balances             LedgerBalance[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([groupId])
  @@index([nature])
}

model Voucher {
  id              String        @id @default(cuid())
  businessId      String
  branchId        String?
  fyCode          String
  voucherType     VoucherType
  voucherNumber   String
  voucherDate     DateTime      @db.Date
  narration       String?
  totalAmount     Decimal       @default(0) @db.Decimal(15, 2)
  status          VoucherStatus @default(DRAFT)
  referenceType   String?
  referenceId     String?
  postedAt        DateTime?
  postedBy        String?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  reversalOfId    String?
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  reversalOf      Voucher?      @relation("VoucherReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals       Voucher[]     @relation("VoucherReversal")
  entries         VoucherEntry[]

  @@unique([businessId, fyCode, voucherNumber])
  @@index([businessId])
  @@index([branchId])
  @@index([fyCode])
  @@index([voucherType])
  @@index([voucherDate])
  @@index([status])
  @@index([referenceType, referenceId])
}

model VoucherEntry {
  id           String   @id @default(cuid())
  voucherId    String
  ledgerId     String
  debitAmount  Decimal  @default(0) @db.Decimal(15, 2)
  creditAmount Decimal  @default(0) @db.Decimal(15, 2)
  narration    String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  voucher      Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledger       Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Restrict)

  @@index([voucherId])
  @@index([ledgerId])
}

model LedgerBalance {
  id         String   @id @default(cuid())
  businessId String
  ledgerId   String
  fyCode     String
  openingDr  Decimal  @default(0) @db.Decimal(15, 2)
  openingCr  Decimal  @default(0) @db.Decimal(15, 2)
  totalDr    Decimal  @default(0) @db.Decimal(15, 2)
  totalCr    Decimal  @default(0) @db.Decimal(15, 2)
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ledger     Ledger   @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@unique([ledgerId, fyCode])
  @@index([businessId])
  @@index([ledgerId])
}

// ============================================================================
// PAKKACHITTHA KNOWLEDGE HUB MODULE (ISOLATED PUBLIC & ADMIN ECOSYSTEM)
// ============================================================================

enum KhStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum KhLanguage {
  EN
  HI
  BOTH
}

enum KhSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  ANSWERED
}

model KhCategory {
  id            String          @id @default(cuid())
  slug          String          @unique
  nameEn        String
  nameHi        String
  descriptionEn String?         @db.Text
  descriptionHi String?         @db.Text
  icon          String?
  imageUrl      String?
  displayOrder  Int             @default(0)
  isActive      Boolean         @default(true)
  articleCount  Int             @default(0)
  questionCount Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  subcategories KhSubcategory[]
  questions     KhQuestion[]
  articles      KhArticle[]
  submissions   KhSubmission[]

  @@index([slug])
  @@index([isActive])
  @@index([displayOrder])
}

model KhSubcategory {
  id            String       @id @default(cuid())
  categoryId    String
  slug          String
  nameEn        String
  nameHi        String
  descriptionEn String?      @db.Text
  descriptionHi String?      @db.Text
  displayOrder  Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  category      KhCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions     KhQuestion[]
  articles      KhArticle[]

  @@unique([categoryId, slug])
  @@index([categoryId])
  @@index([isActive])
  @@index([displayOrder])
}

model KhQuestion {
  id                   String          @id @default(cuid())
  slug                 String          @unique
  categoryId           String
  subcategoryId        String?
  language             KhLanguage      @default(BOTH)
  status               KhStatus        @default(DRAFT)
  titleEn              String
  titleHi              String
  shortAnswerEn        String          @db.Text
  shortAnswerHi        String          @db.Text
  detailedAnswerEn     String?         @db.Text
  detailedAnswerHi     String?         @db.Text
  simpleExplanationEn  String?         @db.Text
  simpleExplanationHi  String?         @db.Text
  practicalExampleEn   String?         @db.Text
  practicalExampleHi   String?         @db.Text
  importantPointsEn    String?         @db.Text
  importantPointsHi    String?         @db.Text
  referencesEn         String?         @db.Text
  referencesHi         String?         @db.Text
  viewCount            Int             @default(0)
  helpfulCount         Int             @default(0)
  notHelpfulCount      Int             @default(0)
  displayOrder         Int             @default(0)
  isFeatured           Boolean         @default(false)
  publishedAt          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  category             KhCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory          KhSubcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  tags                 KhContentTag[]
  feedbacks            KhFeedback[]
  bookmarks            KhBookmark[]

  @@index([slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([language])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([viewCount])
}

model KhArticle {
  id                 String          @id @default(cuid())
  slug               String          @unique
  categoryId         String
  subcategoryId      String?
  language           KhLanguage      @default(BOTH)
  status             KhStatus        @default(DRAFT)
  titleEn            String
  titleHi            String
  summaryEn          String          @db.Text
  summaryHi          String          @db.Text
  contentEn          String          @db.Text
  contentHi          String          @db.Text
  featuredImage      String?
  readingTimeMinutes Int             @default(5)
  authorName         String?         @default("PakkaChittha Editorial Team")
  reviewerName       String?
  seoTitleEn         String?
  seoTitleHi         String?
  seoDescriptionEn   String?         @db.Text
  seoDescriptionHi   String?         @db.Text
  canonicalUrl       String?
  viewCount          Int             @default(0)
  helpfulCount       Int             @default(0)
  notHelpfulCount    Int             @default(0)
  displayOrder       Int             @default(0)
  isFeatured         Boolean         @default(false)
  publishedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  category           KhCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory        KhSubcategory?  @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  tags               KhContentTag[]
  feedbacks          KhFeedback[]
  bookmarks          KhBookmark[]

  @@index([slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@index([language])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([viewCount])
}

model KhTag {
  id          String         @id @default(cuid())
  name        String         @unique
  createdAt   DateTime       @default(now())

  contentTags KhContentTag[]

  @@index([name])
}

model KhContentTag {
  id         String      @id @default(cuid())
  tagId      String
  questionId String?
  articleId  String?

  tag        KhTag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  question   KhQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  article    KhArticle?  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([tagId, questionId, articleId])
  @@index([tagId])
  @@index([questionId])
  @@index([articleId])
}

model KhSubmission {
  id                  String             @id @default(cuid())
  name                String?
  email               String?
  question            String             @db.Text
  categoryId          String?
  preferredLang       String             @default("hi")
  status              KhSubmissionStatus @default(PENDING)
  adminNotes          String?            @db.Text
  convertedQuestionId String?
  ipHash              String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  category            KhCategory?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
}

model KhFeedback {
  id           String      @id @default(cuid())
  questionId   String?
  articleId    String?
  isHelpful    Boolean
  feedbackText String?     @db.Text
  ipHash       String?
  createdAt    DateTime    @default(now())

  question     KhQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  article      KhArticle?  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@index([articleId])
  @@index([createdAt])
}

model KhBookmark {
  id         String      @id @default(cuid())
  userId     String
  questionId String?
  articleId  String?
  createdAt  DateTime    @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   KhQuestion? @relation(fields: [questionId], references: [id], onDelete: Cascade)
  article    KhArticle?  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId, articleId])
  @@index([userId])
  @@index([questionId])
  @@index([articleId])
}

