datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

generator client {
  provider = "prisma-client-js"
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum BusinessRole {
  BUSINESS_OWNER
  BILLING_STAFF
  ACCOUNTANT
  INVENTORY_MANAGER
}

enum SubscriptionPlan {
  FREE_TRIAL
  STARTER
  GROWTH_PRO
  ENTERPRISE
  FREE_KHATA
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  SUSPENDED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum GstType {
  CGST_SGST
  IGST
  EXEMPT
}

enum WhatsAppConfigStatus {
  NOT_CONFIGURED
  CONNECTED
  ERROR
}

enum WhatsAppMessageType {
  INVOICE_SHARE
  PAYMENT_RECEIPT
  ACCOUNT_STATEMENT
  PAYMENT_REMINDER
}

enum WhatsAppMessageStatus {
  QUEUED
  SUBMITTED
  DELIVERED
  READ
  FAILED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  phone        String?
  passwordHash String
  googleId     String?      @unique
  avatarUrl    String?
  platformRole PlatformRole @default(USER)
  isDemo       Boolean      @default(false)
  isSuspended  Boolean      @default(false)
  suspendedReason String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships       BusinessMembership[]
  sessions          Session[]
  khataContacts     KhataContact[]
  khataTransactions KhataTransaction[]
  khataRepayments   KhataRepayment[]
  householdMemberships HouseholdMember[]
  createdHouseholdTransactions HouseholdTransaction[]
  sentHouseholdInvitations HouseholdInvitation[]

  @@index([email])
  @@index([googleId])
  @@index([platformRole])
}

model Business {
  id                 String             @id @default(cuid())
  name               String
  legalName          String?
  tradeType          String?
  gstin              String?
  city               String?
  state              String?
  phone              String?
  email              String?
  currency           String             @default("INR")
  address            String?
  pincode            String?
  bankName           String?
  bankAccountNumber  String?
  bankIfsc           String?
  bankUpiId          String?
  invoiceTerms       String?
  allowNegativeStock Boolean            @default(false)
  isDemo             Boolean            @default(false)
  logoUrl            String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  memberships        BusinessMembership[]
  subscriptions      Subscription[]
  sessions           Session[]
  customers          Customer[]
  invoices           Invoice[]
  payments           Payment[]
  invoiceSequence    InvoiceSequence?
  products           Product[]
  stockMovements     StockMovement[]
  suppliers          Supplier[]
  purchases          Purchase[]
  supplierPayments   SupplierPayment[]
  purchaseSequence   PurchaseSequence?
  whatsAppConfig     WhatsAppConfig?
  whatsAppLogs       WhatsAppMessageLog[]
  expenses           Expense[]
  khataContacts      KhataContact[]
  khataTransactions  KhataTransaction[]
  khataRepayments    KhataRepayment[]
  subscriptionPayments SubscriptionPayment[]
  creditDebitNotes   CreditDebitNote[]
  gstr2bImports      Gstr2bImport[]

  @@index([name])
}

model BusinessMembership {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole @default(BUSINESS_OWNER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

model Subscription {
  id                 String             @id @default(cuid())
  businessId         String
  plan               SubscriptionPlan   @default(FREE_TRIAL)
  status             SubscriptionStatus @default(TRIALING)
  startDate          DateTime           @default(now())
  endDate            DateTime?
  trialDaysRemaining Int                @default(14)
  monthlyPrice       Float              @default(0)
  maxMonthlyInvoices Int                @default(500)
  maxCounters        Int                @default(1)
  maxBranches        Int                @default(1)
  maxStaffSeats      Int                @default(3)
  whatsAppQuota      Int                @default(100)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionPayments SubscriptionPayment[]

  @@index([businessId])
}

model Session {
  id           String    @id @default(cuid())
  sessionToken String    @unique
  userId       String
  businessId   String?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business     Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([sessionToken])
  @@index([userId])
  @@index([businessId])
}

model Customer {
  id              String       @id @default(cuid())
  businessId      String
  name            String
  mobile          String
  email           String?
  billingAddress  String?
  shippingAddress String?
  gstin           String?
  openingBalance  Float        @default(0)
  notes           String?
  optedOutWhatsApp Boolean     @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoices        Invoice[]
  payments        Payment[]
  whatsAppLogs    WhatsAppMessageLog[]
  creditDebitNotes CreditDebitNote[]

  @@index([businessId])
  @@index([name])
  @@index([mobile])
}

model InvoiceSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  prefix        String   @default("INV")
  fiscalYear    String
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Invoice {
  id                 String        @id @default(cuid())
  businessId         String
  customerId         String
  invoiceNumber      String
  invoiceDate        DateTime      @default(now())
  dueDate            DateTime
  status             InvoiceStatus @default(UNPAID)

  // GST & Tax Configuration
  gstType            GstType       @default(CGST_SGST)
  isTaxInclusive     Boolean       @default(false)
  isGstInvoice       Boolean       @default(true)

  // Financial figures (calculated strictly server-side with decimal safety)
  subtotal           Float         @default(0)
  discountTotal      Float         @default(0)
  taxTotal           Float         @default(0)
  cgstTotal          Float         @default(0)
  sgstTotal          Float         @default(0)
  igstTotal          Float         @default(0)
  rounding           Float         @default(0)
  total              Float         @default(0)
  paidAmount         Float         @default(0)
  balanceDue         Float         @default(0)

  // Historical snapshot for audit integrity (preserves profile changes)
  customerName       String
  customerMobile     String
  customerGstin      String?
  customerBillingAddress String?
  businessName       String
  businessGstin      String?
  businessAddress    String?
  businessLogoUrl    String?

  notes              String?
  termsAndConditions String?

  // Cancellation & Void Audit Trail
  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        String?

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  business           Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items              InvoiceItem[]
  payments           Payment[]
  whatsAppLogs       WhatsAppMessageLog[]
  creditDebitNotes   CreditDebitNote[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([invoiceDate])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  productId      String?
  hsnCode        String?
  description    String
  quantity       Float
  unit           String   @default("Pcs")
  rate           Float
  discount       Float    @default(0)
  discountType   String   @default("AMOUNT")
  taxRate        Float    @default(0)
  taxAmount      Float    @default(0)
  cgstRate       Float    @default(0)
  cgstAmount     Float    @default(0)
  sgstRate       Float    @default(0)
  sgstAmount     Float    @default(0)
  igstRate       Float    @default(0)
  igstAmount     Float    @default(0)
  lineTotal      Float

  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(cuid())
  businessId      String
  invoiceId       String
  customerId      String
  amount          Float
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod @default(CASH)
  referenceNumber String?
  notes           String?
  idempotencyKey  String?       @unique
  createdAt       DateTime      @default(now())

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([paymentDate])
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_RECEIVED
  SALE_DEDUCTION
  SALE_RETURN
  PURCHASE_RETURN
  MANUAL_ADJUSTMENT
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

model Product {
  id             String          @id @default(cuid())
  businessId     String
  name           String
  sku            String
  barcode        String?
  category       String          @default("General")
  unit           String          @default("Pcs")
  purchasePrice  Float           @default(0)
  sellingPrice   Float           @default(0)
  taxRate        Float           @default(0)
  hsnCode        String?
  currentStock   Float           @default(0)
  openingStock   Float           @default(0)
  lowStockAlert  Float           @default(10)
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  invoiceItems   InvoiceItem[]
  purchaseItems  PurchaseItem[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([name])
  @@index([category])
  @@index([barcode])
  @@index([isActive])
}

model StockMovement {
  id                 String            @id @default(cuid())
  businessId         String
  productId          String
  type               StockMovementType
  quantity           Float
  previousStock      Float
  newStock           Float
  sourceDocumentType String?           // 'INVOICE', 'PURCHASE', 'MANUAL_ADJUSTMENT', 'RETURN'
  sourceDocumentId   String?
  reason             String?
  actorName          String?
  createdAt          DateTime          @default(now())

  business           Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product            Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([productId])
  @@index([type])
  @@index([sourceDocumentType, sourceDocumentId])
  @@index([createdAt])
}

model Supplier {
  id              String            @id @default(cuid())
  businessId      String
  name            String
  phone           String
  email           String?
  address         String?
  gstin           String?
  openingBalance  Float             @default(0)
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases       Purchase[]
  payments        SupplierPayment[]
  creditDebitNotes CreditDebitNote[]

  @@index([businessId])
  @@index([name])
  @@index([phone])
}

model PurchaseSequence {
  id            String   @id @default(cuid())
  businessId    String   @unique
  prefix        String   @default("PUR")
  fiscalYear    String
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Purchase {
  id                     String            @id @default(cuid())
  businessId             String
  supplierId             String
  purchaseNumber         String
  supplierInvoiceNumber  String?
  purchaseDate           DateTime          @default(now())
  dueDate                DateTime?
  status                 PurchaseStatus    @default(DRAFT)

  subtotal               Float             @default(0)
  discountTotal          Float             @default(0)
  taxTotal               Float             @default(0)
  cgstTotal              Float             @default(0)
  sgstTotal              Float             @default(0)
  igstTotal              Float             @default(0)
  total                  Float             @default(0)
  paidAmount             Float             @default(0)
  balanceDue             Float             @default(0)

  // GST & ITC Classification
  itcEligibility         String            @default("ELIGIBLE") // ELIGIBLE, INELIGIBLE, BLOCKED_SEC_17_5, CAPITAL_GOODS, PENDING_VERIFICATION, RECONCILED
  placeOfSupply          String?
  documentUrl            String?

  notes                  String?
  receivedAt             DateTime?
  receivedBy             String?
  cancelledAt            DateTime?
  cancelledBy            String?
  cancellationReason     String?

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  business               Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier               Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items                  PurchaseItem[]
  payments               SupplierPayment[]

  @@unique([businessId, purchaseNumber])
  @@index([businessId])
  @@index([supplierId])
  @@index([status])
  @@index([purchaseDate])
}

model PurchaseItem {
  id           String    @id @default(cuid())
  purchaseId   String
  productId    String?
  hsnCode      String?
  description  String
  quantity     Float
  unit         String    @default("Pcs")
  purchaseRate Float
  discount     Float     @default(0)
  taxRate      Float     @default(0)
  taxAmount    Float     @default(0)
  cgstRate     Float     @default(0)
  cgstAmount   Float     @default(0)
  sgstRate     Float     @default(0)
  sgstAmount   Float     @default(0)
  igstRate     Float     @default(0)
  igstAmount   Float     @default(0)
  lineTotal    Float

  purchase     Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([productId])
}

model SupplierPayment {
  id              String        @id @default(cuid())
  businessId      String
  purchaseId      String
  supplierId      String
  amount          Float
  paymentDate     DateTime      @default(now())
  paymentMethod   PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  notes           String?
  idempotencyKey  String?       @unique
  recordedBy      String?
  createdAt       DateTime      @default(now())

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchase        Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  supplier        Supplier      @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([purchaseId])
  @@index([supplierId])
  @@index([paymentDate])
}

model WhatsAppConfig {
  id                    String               @id @default(cuid())
  businessId            String               @unique
  status                WhatsAppConfigStatus @default(NOT_CONFIGURED)
  phoneNumberId         String?
  wabaId                String?
  accessToken           String?
  webhookVerifyToken    String?
  businessDisplayName   String?
  autoRemindersEnabled  Boolean              @default(false)
  reminderDaysBeforeDue Int                  @default(3)
  reminderOnDueDate     Boolean              @default(true)
  reminderDaysAfterDue  Int                  @default(3)
  quietHoursStart       Int                  @default(21) // 9 PM (24h)
  quietHoursEnd         Int                  @default(9)  // 9 AM (24h)
  isPaused              Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  business              Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model WhatsAppMessageLog {
  id                 String                @id @default(cuid())
  businessId         String
  customerId         String?
  invoiceId          String?
  recipientPhone     String
  recipientName      String?
  messageType        WhatsAppMessageType
  status             WhatsAppMessageStatus @default(SUBMITTED)
  providerMessageId  String?
  contentSummary     String
  idempotencyKey     String?               @unique
  errorMessage       String?
  sentAt             DateTime              @default(now())
  deliveredAt        DateTime?
  readAt             DateTime?
  actor              String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice            Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
  @@index([providerMessageId])
  @@index([createdAt])
}

model Expense {
  id              String        @id @default(cuid())
  businessId      String
  category        String
  payee           String
  amount          Float
  paymentMethod   PaymentMethod @default(CASH)
  expenseDate     DateTime      @default(now())
  referenceNumber String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([category])
  @@index([expenseDate])
}

enum KhataTransactionType {
  GAVE
  RECEIVED
}

enum KhataEntryStatus {
  PENDING
  PARTIAL
  SETTLED
}

model KhataContact {
  id           String             @id @default(cuid())
  businessId   String
  userId       String?
  name         String
  phone        String?
  email        String?
  notes        String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  business     Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions KhataTransaction[]
  repayments   KhataRepayment[]

  @@index([businessId])
  @@index([userId])
  @@index([name])
  @@index([phone])
}

model KhataTransaction {
  id            String               @id @default(cuid())
  businessId    String
  userId        String?
  contactId     String
  type          KhataTransactionType
  amount        Float
  date          DateTime             @default(now())
  dueDate       DateTime?
  description   String?
  status        KhataEntryStatus     @default(PENDING)
  settledAmount Float                @default(0)
  balanceAmount Float
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact       KhataContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  repayments    KhataRepayment[]

  @@index([businessId])
  @@index([userId])
  @@index([contactId])
  @@index([type])
  @@index([status])
  @@index([date])
  @@index([dueDate])
}

model KhataRepayment {
  id            String           @id @default(cuid())
  businessId    String
  userId        String?
  contactId     String
  transactionId String
  amount        Float
  date          DateTime         @default(now())
  paymentMode   PaymentMethod    @default(CASH)
  notes         String?
  createdAt     DateTime         @default(now())

  business      Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact       KhataContact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  transaction   KhataTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([userId])
  @@index([contactId])
  @@index([transactionId])
  @@index([date])
}

model SubscriptionPayment {
  id               String           @id @default(cuid())
  businessId       String
  subscriptionId   String?
  amount           Float
  currency         String           @default("INR")
  plan             SubscriptionPlan
  status           String           @default("SUCCESS") // "PENDING", "SUCCESS", "FAILED", "CANCELLED", "REFUNDED"
  gateway          String           @default("RAZORPAY") // "RAZORPAY", "CASHFREE", "MANUAL_UPI", "BANK_TRANSFER"
  gatewayPaymentId String?
  gatewayOrderId   String?
  idempotencyKey   String?          @unique
  notes            String?
  billingPeriod    String           @default("MONTHLY") // "MONTHLY", "ANNUAL"
  paidAt           DateTime?
  refundedAt       DateTime?
  refundAmount     Float?           @default(0)
  reconciledBy     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  business         Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription     Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([subscriptionId])
  @@index([status])
  @@index([createdAt])
}

model PlatformAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  adminName  String
  action     String   // e.g. "USER_SUSPEND", "USER_REACTIVATE", "TENANT_SUSPEND", "TENANT_REACTIVATE", "PLAN_CORRECTION", "TRIAL_EXTENSION", "PAYMENT_RECONCILE", "SETTINGS_UPDATE"
  targetType String   // e.g. "USER", "BUSINESS", "SUBSCRIPTION", "PAYMENT", "SETTING"
  targetId   String?
  targetName String?
  reason     String?
  outcome    String   @default("SUCCESS") // "SUCCESS" | "FAILED"
  metadata   Json?    // Extra contextual data or diff
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType])
  @@index([createdAt])
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL") // "GENERAL", "BILLING", "SECURITY", "NOTIFICATIONS"
  description String?
  isSecret    Boolean  @default(false)
  updatedBy   String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([category])
}

enum NoteType {
  CREDIT_NOTE
  DEBIT_NOTE
}

model CreditDebitNote {
  id                    String        @id @default(cuid())
  businessId            String
  noteType              NoteType
  noteNumber            String
  noteDate              DateTime      @default(now())
  originalInvoiceId     String?
  originalInvoiceNumber String?
  customerId            String?
  supplierId            String?
  partyName             String
  partyGstin            String?
  reason                String        // "SALES_RETURN", "DEFICIENT_SERVICE", "POST_SALE_DISCOUNT", "PRICE_CORRECTION", "PURCHASE_RETURN"
  
  taxableValue          Float         @default(0)
  taxTotal              Float         @default(0)
  cgstTotal             Float         @default(0)
  sgstTotal             Float         @default(0)
  igstTotal             Float         @default(0)
  total                 Float         @default(0)
  
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  business              Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  originalInvoice       Invoice?      @relation(fields: [originalInvoiceId], references: [id], onDelete: SetNull)
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier              Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([businessId, noteNumber])
  @@index([businessId])
  @@index([noteType])
  @@index([noteDate])
}

model Gstr2bImport {
  id                  String        @id @default(cuid())
  businessId          String
  returnPeriod        String        // e.g. "102026" (MMYYYY)
  financialYear       String        // e.g. "2026-2027"
  sourceFileName      String?
  totalInvoices       Int           @default(0)
  totalTaxable        Float         @default(0)
  totalCgst           Float         @default(0)
  totalSgst           Float         @default(0)
  totalIgst           Float         @default(0)
  matchedCount        Int           @default(0)
  mismatchCount       Int           @default(0)
  missingInBooksCount Int           @default(0)
  missingIn2bCount    Int           @default(0)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  business            Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries             Gstr2bEntry[]

  @@index([businessId])
  @@index([returnPeriod])
}

model Gstr2bEntry {
  id                   String        @id @default(cuid())
  importId             String
  supplierGstin        String
  supplierName         String?
  invoiceNumber        String
  invoiceDate          DateTime
  invoiceType          String        @default("R") // "R" (Regular), "C" (Credit Note), "D" (Debit Note)
  placeOfSupply        String?
  taxableValue         Float         @default(0)
  cgstAmount           Float         @default(0)
  sgstAmount           Float         @default(0)
  igstAmount           Float         @default(0)
  totalAmount          Float         @default(0)
  itcAvailability      String        @default("Y") // "Y" (Eligible), "N" (Ineligible)
  reconciliationStatus String        @default("UNRECONCILED") // "MATCHED", "MISMATCH_TAX", "MISSING_IN_PURCHASES", "DUPLICATE"
  matchedPurchaseId    String?
  matchNotes           String?
  createdAt            DateTime      @default(now())

  gstr2bImport         Gstr2bImport  @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@index([supplierGstin])
  @@index([reconciliationStatus])
}

// ============================================================================
// PAKKACHITTHA GHAR KHARCHA — FREE HOUSEHOLD MODE
// ============================================================================

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum HouseholdTransactionType {
  INCOME
  EXPENSE
}

enum HouseholdInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Household {
  id             String                 @id @default(cuid())
  name           String
  currency       String                 @default("INR")
  monthlyBudget  Float?                 @default(0)
  budgetStartDay Int                    @default(1)
  isArchived     Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  members        HouseholdMember[]
  transactions   HouseholdTransaction[]
  categories     HouseholdCategory[]
  invitations    HouseholdInvitation[]
  budgets        HouseholdMonthlyBudget[]
  settlements    HouseholdSettlement[]

  @@index([name])
}

model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  userId      String
  role        HouseholdRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  paidTransactions     HouseholdTransaction[]         @relation("PaidTransactions")
  expenseSplits        HouseholdExpenseSplit[]
  expenseContributions HouseholdExpenseContribution[]
  settlementsPaid      HouseholdSettlement[]          @relation("SettlementsPaid")
  settlementsReceived  HouseholdSettlement[]          @relation("SettlementsReceived")

  @@unique([userId, householdId])
  @@index([householdId])
  @@index([userId])
}

model HouseholdInvitation {
  id           String                @id @default(cuid())
  householdId  String
  inviterId    String
  inviteeEmail String?
  inviteToken  String                @unique
  role         HouseholdRole         @default(MEMBER)
  status       HouseholdInviteStatus @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  household    Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inviter      User                  @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([inviteToken])
  @@index([inviteeEmail])
}

model HouseholdCategory {
  id            String                   @id @default(cuid())
  householdId   String?                  // Nullable for default templates or scoped to household
  name          String
  type          HouseholdTransactionType
  icon          String?
  color         String?
  monthlyBudget Float?
  isDefault     Boolean                  @default(false)
  isArchived    Boolean                  @default(false)
  subcategories String[]                 @default([])
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  household     Household?               @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions  HouseholdTransaction[]

  @@unique([householdId, name, type])
  @@index([householdId])
  @@index([type])
  @@index([isArchived])
}

model HouseholdTransaction {
  id              String                   @id @default(cuid())
  householdId     String
  createdById     String
  type            HouseholdTransactionType
  amount          Float
  categoryId      String?
  categoryName    String                   // Denormalized snapshot for audit integrity
  subcategory     String?
  date            DateTime                 @default(now())
  paymentMethod   PaymentMethod            @default(CASH)
  description     String?
  payeeMerchant   String?
  notes           String?

  // Splitting & Payer metadata
  isShared        Boolean                  @default(false)
  splitType       String?                  // 'EQUAL' | 'CUSTOM' | null
  paidByMemberId  String?
  paidByName      String?

  // Bills & Recharge metadata
  billType        String?                  // 'MOBILE_RECHARGE' | 'MOBILE_POSTPAID' | 'ELECTRICITY' | 'WATER' | 'GAS' | 'INTERNET' | 'DTH' | null
  billProvider    String?
  billConsumerId  String?
  billPeriod      String?
  billDueDate     DateTime?
  billReferenceNo String?

  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  household       Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  category        HouseholdCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  paidByMember    HouseholdMember?         @relation("PaidTransactions", fields: [paidByMemberId], references: [id], onDelete: SetNull)

  splits          HouseholdExpenseSplit[]
  contributions   HouseholdExpenseContribution[]

  @@index([householdId])
  @@index([householdId, date])
  @@index([householdId, type])
  @@index([createdById])
  @@index([categoryId])
  @@index([isShared])
  @@index([billType])
  @@index([paidByMemberId])
}

model HouseholdExpenseSplit {
  id              String               @id @default(cuid())
  transactionId   String
  memberId        String
  allocatedAmount Float
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  transaction     HouseholdTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  member          HouseholdMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([transactionId, memberId])
  @@index([transactionId])
  @@index([memberId])
}

model HouseholdExpenseContribution {
  id            String               @id @default(cuid())
  transactionId String
  memberId      String
  amount        Float
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  transaction   HouseholdTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  member        HouseholdMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([transactionId, memberId])
  @@index([transactionId])
  @@index([memberId])
}

model HouseholdSettlement {
  id               String          @id @default(cuid())
  householdId      String
  payerMemberId    String
  receiverMemberId String
  amount           Float
  date             DateTime        @default(now())
  paymentMethod    PaymentMethod   @default(UPI)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payerMember      HouseholdMember @relation("SettlementsPaid", fields: [payerMemberId], references: [id], onDelete: Cascade)
  receiverMember   HouseholdMember @relation("SettlementsReceived", fields: [receiverMemberId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([payerMemberId])
  @@index([receiverMemberId])
  @@index([date])
}

model HouseholdMonthlyBudget {
  id          String    @id @default(cuid())
  householdId String
  monthYear   String    // e.g. "2026-10"
  amount      Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, monthYear])
  @@index([householdId])
}


